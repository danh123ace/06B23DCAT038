<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #f3f6fb;
    color: #19324d;
    font: 15px Arial, sans-serif;
  }

  .shell {
    max-width: 1080px;
    margin: 36px auto;
    padding: 0 18px;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    border-radius: 10px 10px 0 0;
    background: #1d3c63;
    color: #fff;
  }

  .top h1 {
    margin: 0;
    font-size: 20px;
  }

  .card {
    padding: 24px;
    border: 1px solid #dbe4ef;
    border-radius: 0 0 10px 10px;
    background: #fff;
    box-shadow: 0 8px 24px #203a5912;
  }

  .muted {
    color: #62758b;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .field label {
    display: block;
    margin: 0 0 7px;
    font-weight: 600;
  }

  .field input,
  .field select {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid #cbd6e2;
    border-radius: 6px;
    font: inherit;
  }

  .btn {
    display: inline-block;
    padding: 11px 17px;
    border: 0;
    border-radius: 6px;
    background: #356ac3;
    color: #fff;
    text-decoration: none;
    font: inherit;
    cursor: pointer;
  }

  .btn.secondary {
    background: #e8eef7;
    color: #244465;
  }

  .btn.red {
    background: #d85e69;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 18px 0;
  }

  .notice {
    margin: 14px 0;
    padding: 12px 14px;
    border-radius: 6px;
    background: #edf5ff;
  }

  .notice.error {
    background: #fff0f0;
    color: #a22;
  }

  .notice.ok {
    background: #ecf9f0;
    color: #1f7542;
  }

  table {
    width: 100%;
    margin-top: 18px;
    border-collapse: collapse;
    background: #fff;
  }

  th,
  td {
    padding: 12px;
    border-bottom: 1px solid #e0e7ef;
    text-align: left;
  }

  th {
    background: #edf3fa;
    color: #1e3d62;
  }

  tr.clickable:hover {
    background: #f2f7ff;
  }

  a.rowlink {
    display: block;
    color: #19324d;
    text-decoration: none;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .stat {
    min-width: 170px;
    padding: 15px 20px;
    border-radius: 8px;
    background: #f1f6fd;
  }

  .stat strong {
    display: block;
    margin-top: 6px;
    font-size: 21px;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .top {
      align-items: flex-start;
      gap: 12px;
    }

    .shell {
      margin: 14px auto;
    }

    .card {
      padding: 16px;
    }

    table {
      font-size: 13px;
    }
  }
</style>